import numpy as np
import matplotlib.pyplot as plt
import scan_plot_and_analysis as spa

import spm_control.config as config

scan_settings = config.load_scan_settings()

def create_filtered_scan_plot(file_path, channel):
    Xs, Ys, Ts, ch1, ch2 = spa.load_scan_data(
        100,
        100,
        1,
        file_path
    )

    x_min = scan_settings["x_min"]
    x_max = scan_settings["x_max"]

    if channel == 1:
        intensities = ch1.copy()
    elif channel == 2:
        intensities = ch2.copy()
    elif channel == 0:
        intensities = ch1 + ch2
    else:
        raise ValueError("Channel must be 0, 1, or 2.")

    masked_intensities = np.ma.masked_outside(
        intensities,
        x_min,
        x_max
    )

    fig, ax = plt.subplots(figsize=(8, 8))

    plot = ax.pcolormesh(
        Xs,
        Ys,
        masked_intensities,
        cmap="viridis",
        shading="auto"
    )

    ax.set_aspect("equal")
    ax.set_xlabel("X (µm)")
    ax.set_ylabel("Y (µm)")
    ax.set_title(f"Channel {channel}")

    fig.colorbar(
        plot,
        ax=ax,
        label="Intensity (counts/s)"
    )

    fig.tight_layout()

    return fig